{
  "namespace": "geumyi_chest",
  "chest_panel": {
    "type": "panel",
    "size": [
      "100%",
      "100%"
    ],
    "controls": [
      {
        "root": {
          "type": "panel",
          "size": [
            196,
            185
          ],
          "anchor_from": "center_middle",
          "anchor_to": "center_middle",
          "layer": 1,
          "controls": [
            {
              "bg@common.dialog_background_opaque": {
                "size": [
                  196,
                  185
                ],
                "anchor_from": "top_left",
                "anchor_to": "top_left"
              }
            },
            {
              "subspace_label@common.section_heading_label": {
                "offset": [
                  8,
                  5
                ],
                "size": [
                  180,
                  11
                ],
                "text": "아공간",
                "localize": false
              }
            },
            {
              "inventory_label@common.section_heading_label": {
                "offset": [
                  8,
                  81
                ],
                "size": [
                  180,
                  11
                ],
                "text": "인벤토리",
                "localize": false
              }
            },
            {
              "close@common.close_button": {}
            },
            {
              "grid": {
                "type": "grid",
                "size": [
                  180,
                  160
                ],
                "offset": [
                  8,
                  19
                ],
                "anchor_from": "top_left",
                "anchor_to": "top_left",
                "grid_dimensions": [
                  9,
                  8
                ],
                "grid_item_template": "geumyi_chest.inventory_item_panel",
                "collection_name": "form_buttons",
                "layer": 2
              }
            }
          ]
        }
      }
    ]
  },
  "inventory_item_panel": {
    "type": "panel",
    "size": [
      20,
      20
    ],
    "layer": 1,
    "controls": [
      {
        "item@geumyi_chest.slot_button": {}
      }
    ]
  },
  "slot_button@common.button": {
    "$pressed_button_name": "button.form_button_click",
    "bindings": [
      {
        "binding_name": "#null",
        "binding_type": "collection",
        "binding_condition": "none",
        "binding_collection_name": "form_buttons"
      },
      {
        "binding_name": "#null",
        "binding_type": "collection_details",
        "binding_collection_name": "form_buttons"
      },
      {
        "binding_name": "#form_button_text",
        "binding_type": "collection",
        "binding_collection_name": "form_buttons"
      },
      {
        "binding_type": "view",
        "source_property_name": "(not (#form_button_text = ''))",
        "target_property_name": "#visible"
      }
    ],
    "default_control": "default",
    "hover_control": "hover",
    "pressed_control": "pressed",
    "controls": [
